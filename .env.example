# Copy to .env.local and fill in. Never commit real values. Names only here.

# Public site URL, no trailing slash. Used for Stripe return links, ticket links and QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe secret key. Use a TEST key (sk_test_...) until you are ready to take real money.
STRIPE_SECRET_KEY=

# Signing secret (whsec_...) for the webhook endpoint /api/skylounge-webhook
STRIPE_WEBHOOK_SECRET=

# Supabase project URL and the SERVICE ROLE key (server-only secret).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key, used to email e-tickets after payment.
RESEND_API_KEY=

# Sender for ticket emails, e.g. "Atlanta Pulse <tickets@your-verified-domain.com>".
# Leave empty to use Resend's test sender, which only delivers to your own Resend account email.
AWP_EMAIL_FROM=

# Door/staff PIN for /skylounge-rooftop/door and QR check-in. At least 6 characters.
AWP_DOOR_PIN=
